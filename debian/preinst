#!/bin/sh
set -e
# Our serviceproviders.xml replaces mobile-broadband-provider-info's.
if [ "$1" = install ] || [ "$1" = upgrade ]; then
	dpkg-divert --package adaptation-sony-pdx206-extras --add --rename \
		--divert /usr/share/mobile-broadband-provider-info/serviceproviders.xml.mbpi /usr/share/mobile-broadband-provider-info/serviceproviders.xml
fi
#DEBHELPER#
